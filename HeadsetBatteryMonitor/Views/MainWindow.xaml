<Window x:Class="HeadsetBatteryMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Headset Battery Monitor"
        Height="300"
        Width="500"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Monitor de bateria do headset"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="{Binding Status}"
                       FontSize="16"
                       Margin="0,0,0,10"/>

            <TextBlock Text="{Binding HeadsetName}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <TextBlock Text="{Binding DeviceDetails}"
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
